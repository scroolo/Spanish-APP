# Backend environment variables (copy to .env)
# PostgreSQL connection string
DATABASE_URL=postgres://spanish:spanish@localhost:5432/spanishteacher

# JWT signing secret — MUST be changed in production
JWT_SECRET=change-me-in-production-please-32-chars-min

# Server port
PORT=4000

# Allowed CORS origins (comma separated) for the mobile app during dev
CORS_ORIGINS=*

# Log level: info | debug | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# AI provider (Phase 2)
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock runs fully offline with deterministic outputs — no API key
# needed. Use "openai" with an OpenAI-compatible /chat/completions endpoint.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# Structured output retries before falling back to deterministic content.
AI_STRUCTURED_RETRIES=3
# Max size of the learning context block sent to the provider.
AI_CONTEXT_MAX_CHARS=9000

# ---------------------------------------------------------------------------
# Text-to-speech (Phase 2)
# ---------------------------------------------------------------------------
# TTS_PROVIDER=mock produces a small playable tone WAV (no real speech).
# "openai" uses the OpenAI TTS endpoint; "elevenlabs" is accepted but
# currently resolves to the same remote client interface.
TTS_PROVIDER=mock
TTS_VOICE=alloy
TTS_MODEL=tts-1
# TTS_API_KEY=sk-...
# TTS_BASE_URL=https://api.openai.com/v1
# Directory where generated audio files are stored.
# MEDIA_DIR=./media/tts
# Bump to force regeneration of all cached TTS assets (voice/provider change).
# TTS_CACHE_VERSION=1

# ---------------------------------------------------------------------------
# Speech-to-text (Phase 2)
# ---------------------------------------------------------------------------
# STT_PROVIDER=mock returns empty transcripts (every attempt evaluates as
# 'unrecognized' — it does NOT process audio). "openai" uses OpenAI Whisper;
# "groq" uses Groq's OpenAI-compatible endpoint (free tier / faster).
STT_PROVIDER=mock
STT_MODEL=whisper-1
# STT_API_KEY=sk-...
# STT_BASE_URL=https://api.openai.com/v1
# When STT_PROVIDER=groq, use GROQ_API_KEY (Groq-specific). The following are
# optional; defaults target Groq's OpenAI-compatible API.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=whisper-large-v3-turbo
# Maximum accepted audio length (seconds) per transcription request.
STT_MAX_AUDIO_SECONDS=30

# ---------------------------------------------------------------------------
# Rate limits (per user, per hour). -1 disables a limit. In-memory only.
# ---------------------------------------------------------------------------
RATE_LIMIT_AI_PER_HOUR=60
RATE_LIMIT_TTS_PER_HOUR=90
RATE_LIMIT_STT_PER_HOUR=40
