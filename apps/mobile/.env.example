# Mobile environment variables (optional). Copy this file to `apps/mobile/.env`
# for local development. Expo inlines every `EXPO_PUBLIC_*` variable at bundle
# build time — it is NOT read from the device at runtime.

# Base URL of the backend API, including the `/api` suffix.
#
# Leave unset during local development: the app falls back to the emulator
# loopback (Android 10.0.2.2, iOS localhost) automatically when running in
# __DEV__ mode.
#
# For a physical phone during development, point it at your computer's LAN IP,
# e.g. http://192.168.1.20:4000/api
#
# For EAS preview/production builds you MUST bake the reachable URL into the
# build, because release builds do not use the dev fallback:
#   eas build --platform android --profile preview --env EXPO_PUBLIC_API_URL=https://api.example.com/api
# (or set EXPO_PUBLIC_API_URL as an EAS environment variable / secret).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
